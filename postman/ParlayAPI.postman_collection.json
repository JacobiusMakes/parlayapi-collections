    {
      "name": "Remote MCP",
      "item": [
        {
          "name": "MCP: initialize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp/http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "http"
              ],
              "query": []
            },
            "description": "MCP streamable HTTP endpoint hosted by ParlayAPI. Remote-capable MCP clients (claude.ai connectors, hosted agents) normally do this handshake for you: just point them at https://parlay-api.com/mcp/http. Keyless requests get the discovery and signup tools; add Authorization: Bearer <api_key> for the full set. Some deployments require the Mcp-Session-Id response header from initialize to be echoed on later calls. If this request returns 404 the remote transport is not deployed yet: install the local server instead with: uvx parlayapi-mcp (source: https://github.com/JacobiusMakes/parlay-api-mcp).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-06-18\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"parlayapi-collections\",\n      \"version\": \"1.0.0\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "MCP: list tools",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp/http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp",
                "http"
              ],
              "query": []
            },
            "description": "MCP streamable HTTP endpoint hosted by ParlayAPI. Remote-capable MCP clients (claude.ai connectors, hosted agents) normally do this handshake for you: just point them at https://parlay-api.com/mcp/http. Keyless requests get the discovery and signup tools; add Authorization: Bearer <api_key> for the full set. Some deployments require the Mcp-Session-Id response header from initialize to be echoed on later calls. If this request returns 404 the remote transport is not deployed yet: install the local server instead with: uvx parlayapi-mcp (source: https://github.com/JacobiusMakes/parlay-api-mcp).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\",\n  \"params\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
