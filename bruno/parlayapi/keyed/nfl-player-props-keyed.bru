meta {
  name: NFL player props (keyed)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/sports/americanfootball_nfl/props
  body: none
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

assert {
  res.status: eq 200
}

docs {
  Metered player props for an account with access. Use the keyless NFL sandbox request to practice. Check current plan access and costs before sending this request.
}
