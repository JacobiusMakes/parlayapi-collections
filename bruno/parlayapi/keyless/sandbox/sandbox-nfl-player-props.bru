meta {
  name: Sandbox NFL player props
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/sandbox/sports/americanfootball_nfl/props
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("Rows belong to the NFL sandbox sample", function () {
    const body = res.getBody();
    expect(body.sport_key).to.equal("americanfootball_nfl");
    expect(body.props).to.be.an("array");
    expect(body.count).to.equal(body.props.length);
    for (const row of body.props) {
      expect(row.is_sandbox).to.equal(true);
    }
  });
}

docs {
  Practice with labeled NFL example rows. An empty props array contains no usable observation.
}
